{
    "name": "alchemist/mantis",
    "description": "Enterprise AI Security & Financial Radar for Laravel",
    "type": "library",
    "keywords": ["laravel", "ai", "security", "firewall", "openai", "rate-limiting", "redis"],
    "license": "MIT",
    "authors": [
        {
            "name": "Alchemist",
            "email": "admin@alchemist-security.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
